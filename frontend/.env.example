# Copie para .env e ajuste o que precisar. O arquivo .env não é versionado.

# API REST do backend. Sem esta variável o frontend usa http://localhost:8080/api.
VITE_API_URL=http://localhost:8080/api

# Chatbot de recomendação (RNF0044). Sem estas duas variáveis o chat usa o
# recomendador local de src/utils/recomendacao.ts e a loja funciona normalmente.
#
# ATENÇÃO: o Vite embute qualquer VITE_* no bundle do navegador, então a chave
# fica visível no DevTools. Serve para demonstrar a integração; em produção a
# chamada precisa sair do servidor, com a chave guardada lá.
VITE_DIFY_API_URL=
VITE_DIFY_API_KEY=
